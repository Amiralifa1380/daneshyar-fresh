<resources>
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurface">@color/surface_ink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <!-- API 26 has light navigation icons: use a dark background. -->
        <item name="android:navigationBarColor">#12283F</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
